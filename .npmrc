# ---------------------------------------------------------------------------
# Ajustes de pnpm/npm para el monorepo.
# ---------------------------------------------------------------------------
# El árbol de dependencias es grande (Fastify, Prisma, Baileys, Vite, React) y
# Baileys arrastra muchos paquetes pequeños. Con la concurrencia por defecto,
# una conexión inestable corta las descargas a mitad de camino con errores
# UND_ERR_DESTROYED / ECONNRESET. Estos valores priorizan terminar la
# instalación por sobre la velocidad.
#
# Si la instalación se corta igual, volver a ejecutar `pnpm install`: la tienda
# conserva lo que ya se descargó y cada intento avanza más.
# ---------------------------------------------------------------------------

fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
network-concurrency=3
fetch-timeout=300000

# Los scripts de compilación permitidos se declaran en pnpm-workspace.yaml
# (allowBuilds); no se quiere que la instalación falle por el resto.
strict-dep-builds=false
