# ---------------------------------------------------------------------------
# Copiar a .env y completar.  NUNCA subir el .env al repositorio.
# ---------------------------------------------------------------------------

# --- API -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# URL pública de la web: es la base del enlace /i/<slug>/<token> de cada mensaje.
# En desarrollo, localhost está bien (modo seco); para enviar de verdad tiene que
# ser una dirección que se abra desde el teléfono de un invitado, por ejemplo
# https://bodas.tudominio.com. Opciones gratis y de bajo coste: docs/10-url-publica.md
PUBLIC_WEB_URL=http://localhost:5173
# URL pública de la API (la usa la web y los webhooks)
PUBLIC_API_URL=http://localhost:4000
# Deja enviar mensajes REALES aunque el enlace sea local. Solo para probar con un
# teléfono propio en la misma red: ningún invitado podría abrir su invitación.
ALLOW_LOCAL_LINKS=false

# --- Base de datos ---------------------------------------------------------
# Desarrollo: SQLite (cero configuración)
DATABASE_URL="file:./dev.db"
# Producción (Railway/Render): PostgreSQL -> cambiar también prisma/schema.prisma y ejecutar migraciones
# DATABASE_URL="postgresql://usuario:clave@host:5432/boda_studio?schema=public"

# --- Seguridad -------------------------------------------------------------
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ADMIN_EMAIL=organizadora@bodastudio.com
ADMIN_PASSWORD=CambiarEstaClave123

# --- WhatsApp --------------------------------------------------------------
# baileys    -> no oficial, gratis, la organizadora escanea un QR (por defecto)
# cloud-api  -> API oficial de Meta (requiere WHATSAPP_* de abajo)
# preview    -> modo seco: no envía nada, solo registra el mensaje renderizado
WHATSAPP_ENGINE=baileys
# Carpeta donde se guarda la sesión de WhatsApp (en producción: volumen persistente)
WHATSAPP_SESSION_DIR=./storage/sessions

# --- Fotos de las invitaciones ---------------------------------------------
# Carpeta donde se guardan las fotos que se suben desde el panel. En producción
# tiene que ser un volumen persistente (docker-compose usa /app/storage/uploads):
# si se pierde, las invitaciones quedan sin fotos.
UPLOAD_DIR=./storage/uploads

# --- API oficial de Meta (solo si WHATSAPP_ENGINE=cloud-api) ---------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=invitacion_boda
WHATSAPP_TEMPLATE_LANG=es

# --- Envío masivo ----------------------------------------------------------
# Retardo aleatorio entre mensajes (ms). NUNCA bajar de 4000: el riesgo de bloqueo es real.
SEND_MIN_DELAY_MS=6000
SEND_MAX_DELAY_MS=14000
# Tope diario de mensajes por sesión de WhatsApp
SEND_DAILY_LIMIT=250
