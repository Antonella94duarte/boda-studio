# ---------------------------------------------------------------------------
# Plantilla del .env de PRODUCCIÓN (servidor con HTTPS).
# Copiar a `.env` en la raíz del repositorio y completar los valores.
# NUNCA subir el .env al repositorio.
# ---------------------------------------------------------------------------
# Cómo se usa (todo desde el navegador, ver docs/11-despliegue-desde-el-navegador.md):
#   1. Reemplazá cada <...> por tu valor.
#   2. Guardá el archivo como `.env` al lado de docker-compose.yml.
#   3. docker compose -f docker-compose.yml -f deploy/docker-compose.caddy.yml up -d --build
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=4000

# El dominio real. Es la base del enlace /i/<slug>/<token> de cada mensaje y lo
# que Caddy usa para pedir el certificado: sin https:// y con el dominio exacto.
# La API se publica en el mismo dominio (nginx proxya /api), así que las dos
# variables van con la misma base.
PUBLIC_WEB_URL=https://<tu-dominio>
PUBLIC_API_URL=https://<tu-dominio>

# Nunca true en producción: permitiría enviar mensajes con enlaces locales.
ALLOW_LOCAL_LINKS=false

# --- Base de datos ---------------------------------------------------------
# SQLite dentro del volumen `db_data` (es el provider del esquema de Prisma).
# El compose ya define este valor; está acá para que se vea. Si usás PostgreSQL
# externo, reemplazalo y cambiá el provider del esquema a "postgresql".
DATABASE_URL=file:/app/storage/db/prod.db

# --- Seguridad -------------------------------------------------------------
# Generar uno propio, largo y aleatorio. Desde el navegador (consola del
# servidor o Cloud Shell):
#   openssl rand -hex 48
JWT_SECRET=<48 bytes aleatorios en hexadecimal>

ADMIN_EMAIL=<correo-de-la-organizadora>
ADMIN_PASSWORD=<clave fuerte, mínimo 8 caracteres>

# --- WhatsApp --------------------------------------------------------------
# baileys   -> no oficial, gratis, se conecta escaneando un QR (recomendado acá)
# cloud-api -> API oficial de Meta (requiere las WHATSAPP_* de abajo)
# preview   -> no envía nada, solo registra el texto (para probar el panel)
WHATSAPP_ENGINE=baileys
WHATSAPP_SESSION_DIR=/app/storage/sessions

# --- Fotos de las invitaciones ---------------------------------------------
# Volumen persistente del compose. Si se pierde, hay que volver a subir las fotos.
UPLOAD_DIR=/app/storage/uploads

# --- API oficial de Meta (solo si WHATSAPP_ENGINE=cloud-api) ---------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=invitacion_boda
WHATSAPP_TEMPLATE_LANG=es

# --- Envío masivo ----------------------------------------------------------
# NUNCA bajar de 4000 ms: el riesgo de bloqueo del número es real.
SEND_MIN_DELAY_MS=6000
SEND_MAX_DELAY_MS=14000
SEND_DAILY_LIMIT=250
